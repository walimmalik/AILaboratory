{
  "name": "@ailab/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --conditions=source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env --conditions=source src/db/migrate.ts",
    "bootstrap": "tsx --env-file-if-exists=../../.env --conditions=source src/bootstrap.ts",
    "token": "tsx --env-file-if-exists=../../.env --conditions=source src/token.ts",
    "password": "tsx --env-file-if-exists=../../.env --conditions=source src/password.ts",
    "seed": "tsx --env-file-if-exists=../../.env --conditions=source src/seed.ts",
    "library:import": "tsx --env-file-if-exists=../../.env --conditions=source src/library-import.ts"
  },
  "dependencies": {
    "@ailab/domain": "workspace:*",
    "@ailab/schema": "workspace:*",
    "@anthropic-ai/sdk": "0.129.0",
    "@hono/node-server": "2.1.3",
    "@modelcontextprotocol/sdk": "1.31.0",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.11",
    "pg": "8.23.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
