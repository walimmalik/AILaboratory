# Copy to .env for local development. Never commit .env.
POSTGRES_USER=ailab
POSTGRES_PASSWORD=ailab-dev-only
POSTGRES_DB=ailab
DATABASE_URL=postgres://ailab:ailab-dev-only@localhost:5432/ailab
API_PORT=3001
SCIENCE_PORT=8001

# First-run setup (bootstrap command). Without BOOTSTRAP_PASSWORD a password is generated and printed once.
BOOTSTRAP_USER=Lab owner
BOOTSTRAP_EMAIL=owner@lab.local

# In-app agent (plan 004b): openrouter or anthropic, with your own key.
AGENT_PROVIDER=openrouter
OPENROUTER_API_KEY=
AGENT_MODEL=deepseek/deepseek-chat
