# Copy to .env for local development. Never commit .env.
POSTGRES_USER=ailab
POSTGRES_PASSWORD=ailab-dev-only
POSTGRES_DB=ailab
DATABASE_URL=postgres://ailab:ailab-dev-only@localhost:5432/ailab
API_PORT=3001
SCIENCE_PORT=8001

# First-run setup (bootstrap command). Without BOOTSTRAP_PASSWORD a password is generated and printed once.
BOOTSTRAP_USER=Lab owner
BOOTSTRAP_EMAIL=owner@lab.local

# Where uploaded files are kept (plan 011a). Defaults to data/files under apps/api when unset.
# FILE_STORE_DIR=

# In-app assistant (plan 004b, docs/architecture/assistant.md). Restart the API after changing these.
# openrouter: paste your key below. anthropic: set ANTHROPIC_API_KEY and AGENT_MODEL=claude-opus-5-5.
# openai-compatible: AGENT_BASE_URL (e.g. http://localhost:11434/v1 for Ollama), AGENT_API_KEY, AGENT_MODEL.
AGENT_PROVIDER=openrouter
OPENROUTER_API_KEY=
AGENT_MODEL=deepseek/deepseek-chat
# OpenRouter only: providers to try first, in order (others still used as fallbacks), e.g. fireworks,together
# AGENT_PROVIDER_ORDER=
# ANTHROPIC_API_KEY=
# AGENT_NAME=
