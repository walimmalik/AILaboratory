{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sop": {
      "type": "string",
      "pattern": "^sop_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "expectedVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "variable": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "value": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^-?(0|[1-9]\\d*)(\\.\\d+)?$"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "sop",
    "expectedVersion",
    "variable",
    "value",
    "reason"
  ],
  "additionalProperties": false
}
