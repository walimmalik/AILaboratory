{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "value": {
      "type": "string",
      "pattern": "^-?(0|[1-9]\\d*)(\\.\\d+)?$"
    },
    "unit": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "value",
    "unit"
  ],
  "additionalProperties": false
}
