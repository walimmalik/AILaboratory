    "operation": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "activate",
        "archive",
        "unarchive",
        "restore",
        "confirm_section"
      ]
    },
    "actor": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "user"
            },
            "userId": {
              "type": "string",
              "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
