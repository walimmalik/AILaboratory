{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "recordId": {
      "type": "string",
      "pattern": "^[a-z]{2,5}_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "operation": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "activate",
        "archive",
        "unarchive",
        "restore"
      ]
    },
    "actor": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "user"
            },
            "userId": {
              "type": "string",
              "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "required": [
            "type",
            "userId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "agent"
            },
            "agentName": {
              "type": "string",
              "minLength": 1
            },
            "onBehalfOf": {
              "type": "string",
              "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "sessionRef": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "agentName",
            "onBehalfOf"
          ],
          "additionalProperties": false
        }
      ]
    },
    "reason": {
      "type": "string"
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{2,5}_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Z]{2,5}-\\d+$"
        },
        "label": {
          "type": "string"
        },
        "orgId": {
          "type": "string",
          "pattern": "^(org|lab)_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "labId": {
          "type": "string",
          "pattern": "^(org|lab)_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "archived"
          ]
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "attributes": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "createdBy": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "user"
                },
                "userId": {
                  "type": "string",
                  "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
                }
              },
              "required": [
                "type",
                "userId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "agent"
                },
                "agentName": {
                  "type": "string",
                  "minLength": 1
                },
                "onBehalfOf": {
                  "type": "string",
                  "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
                },
                "sessionRef": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "agentName",
                "onBehalfOf"
              ],
              "additionalProperties": false
            }
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "updatedBy": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "user"
                },
                "userId": {
                  "type": "string",
                  "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
                }
              },
              "required": [
                "type",
                "userId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "agent"
                },
                "agentName": {
                  "type": "string",
                  "minLength": 1
                },
                "onBehalfOf": {
                  "type": "string",
                  "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
                },
                "sessionRef": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "agentName",
                "onBehalfOf"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "label",
        "orgId",
        "labId",
        "status",
        "version",
        "attributes",
        "createdAt",
        "createdBy",
        "updatedAt",
        "updatedBy"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "recordId",
    "version",
    "operation",
    "actor",
    "at",
    "snapshot"
  ],
  "additionalProperties": false
}
