    "recordId": {
      "type": "string",
      "pattern": "^[a-z]{2,5}_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
