{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "user"
        },
        "userId": {
          "type": "string",
          "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      },
      "required": [
        "type",
        "userId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "agent"
        },
        "agentName": {
          "type": "string",
          "minLength": 1
        },
        "onBehalfOf": {
          "type": "string",
          "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "sessionRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "agentName",
        "onBehalfOf"
      ],
      "additionalProperties": false
    }
  ]
}
