{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^prp_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "operationId": {
      "type": "string"
    },
    "input": {},
    "preview": {},
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "failed"
      ]
    },
    "proposedBy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "user"
            },
            "userId": {
              "type": "string",
              "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "required": [
            "type",
            "userId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "agent"
            },
            "agentName": {
              "type": "string",
              "minLength": 1
            },
            "onBehalfOf": {
              "type": "string",
              "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "sessionRef": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "agentName",
            "onBehalfOf"
          ],
          "additionalProperties": false
        }
      ]
    },
    "proposedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "reason": {
      "type": "string"
    },
    "decidedBy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "user"
            },
            "userId": {
              "type": "string",
              "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "required": [
            "type",
            "userId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "agent"
            },
            "agentName": {
              "type": "string",
              "minLength": 1
            },
            "onBehalfOf": {
              "type": "string",
              "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "sessionRef": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "agentName",
            "onBehalfOf"
          ],
          "additionalProperties": false
        }
      ]
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "decisionReason": {
      "type": "string"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "unauthorized",
            "forbidden",
            "unknown_operation",
            "invalid_input",
            "not_found",
            "unknown_kind",
            "invalid_attributes",
            "invalid_state",
            "version_conflict",
            "invalid_link",
            "linked",
            "not_ready",
            "internal"
          ]
        },
        "message": {
          "type": "string"
        },
        "details": {}
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "operationId",
    "input",
    "preview",
    "status",
    "proposedBy",
    "proposedAt"
  ],
  "additionalProperties": false
}
